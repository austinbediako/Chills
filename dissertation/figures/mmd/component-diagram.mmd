    PUB["Public: HomePage, About,<br/>Membership, Contact, Auth"]
    APPP["App: AuthenticatedHome, SocialFeed,<br/>Explore, Bookmarks, MyStories,<br/>WritePage, Profile, AuthorProfile,<br/>Reviews, Authors"]
  end

