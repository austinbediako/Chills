    FORMS["LoginForm, RegisterForm,<br/>PostForm, CommentForm"]
    COMMON["BookmarkDropdown, FollowersModal,<br/>KeyboardShortcutsModal, ImageCropModal,<br/>Notification, ErrorBoundary"]
  end

  subgraph State["State & Services"]
    STORE["Redux store:<br/>auth, submissions, comments, ui slices"]
